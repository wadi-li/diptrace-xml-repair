["<# : DipTrace XML Repair - local server", "@echo off", "setlocal", "set \"DTR_SELF=%~f0\"", "set \"DTR_HOME=%LOCALAPPDATA%\\dt-xml-repair\"", "title DipTrace XML Repair - local server", "rem Copy this file as UTF-8 (BOM) server.ps1 to %LOCALAPPDATA%\\dt-xml-repair and run it with -File.", "powershell -NoProfile -Command \"[void][IO.Directory]::CreateDirectory($env:DTR_HOME); [IO.File]::WriteAllText($env:DTR_HOME + '\\server.ps1', [IO.File]::ReadAllText($env:DTR_SELF, [Text.Encoding]::UTF8), (New-Object Text.UTF8Encoding $true))\"", "if errorlevel 1 goto fail", "powershell -NoProfile -STA -ExecutionPolicy Bypass -File \"%DTR_HOME%\\server.ps1\" %*", "if errorlevel 1 pause", "exit /b", ":fail", "echo Could not write %DTR_HOME%\\server.ps1", "pause", "exit /b", "#>", ""]